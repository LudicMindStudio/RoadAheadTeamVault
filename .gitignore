# Obsidian workspace (machine-specific — splits, open tabs, window positions)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Per-user Obsidian configs (machine-specific — plugin settings, hotkeys, appearance)
.obsidian/app.json
.obsidian/appearance.json
.obsidian/community-plugins.json
.obsidian/core-plugins.json
.obsidian/graph.json
.obsidian/hotkeys.json
.obsidian/templates.json
.obsidian/types.json

# Plugin per-user settings (machine-specific)
.obsidian/plugins/*/data.json

# Dialogue plugin — build/dev artifacts (not needed at runtime)
.obsidian/plugins/obsidian-dialogue-plugin/node_modules/
.obsidian/plugins/obsidian-dialogue-plugin/temp_debug_files/
.obsidian/plugins/obsidian-dialogue-plugin/main.ts
.obsidian/plugins/obsidian-dialogue-plugin/esbuild.config.mjs
.obsidian/plugins/obsidian-dialogue-plugin/tsconfig.json
.obsidian/plugins/obsidian-dialogue-plugin/version-bump.mjs
.obsidian/plugins/obsidian-dialogue-plugin/versions.json
.obsidian/plugins/obsidian-dialogue-plugin/package.json
.obsidian/plugins/obsidian-dialogue-plugin/package-lock.json

# Stray nested .obsidian configs (artifact from opening plugins/ as vault)
.obsidian/plugins/.obsidian/

# Stale git conflicts from Obsidian Git plugin
conflict-files-obsidian-git.md

# Other
*.gdrive
Utitled 1.base
